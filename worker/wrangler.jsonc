{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breakv800-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "breakv800",
      "database_id": "REPLACE_ON_DEPLOY",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
